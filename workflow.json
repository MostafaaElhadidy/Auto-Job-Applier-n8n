                "jsCode": "// Extract the AI's response - Responses API shape: output[0].content[0].text\nconst raw = $input.item.json;\nconst textField = raw.output?.[0]?.content?.[0]?.text;\n\nlet parsedData;\ntry {\n  parsedData = typeof textField === 'string' ? JSON.parse(textField) : textField;\n  if (!parsedData) throw new Error('empty');\n} catch (e) {\n  parsedData = { verdict: false, reason: 'Could not parse AI response' };\n}\n\nreturn {\n  verdict: parsedData.verdict === true || parsedData.verdict === \"true\",\n  reason: parsedData.reason\n};"

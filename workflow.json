        {
            "parameters": {
                "jsCode": "// Build a set of job URLs already logged in the tracker sheet\nconst existingUrls = new Set(\n  $input.all()\n    .map(item => item.json.JobUrl)\n    .filter(Boolean)\n);\n\n// Keep only scraped jobs that aren't already in the sheet AND aren't repeated\n// within this same scrape batch (the scraper can return the same listing once\n// per search string, e.g. \"AI Engineer - Egypt\" and \"Machine Learning Engineer - Egypt\")\nconst seenThisRun = new Set();\nconst newJobs = $('Scrape Jobs').all().filter(item => {\n  const url = item.json.jobUrl;\n  if (!url || existingUrls.has(url) || seenThisRun.has(url)) return false;\n  seenThisRun.add(url);\n  return true;\n});\n\nreturn newJobs;"
            },
